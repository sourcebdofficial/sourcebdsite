MONGODB_URI=
JWT_SECRET=

# Gmail SMTP email OTP (use a Google App Password, not your Gmail password)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Email OTP through Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS OTP through Twilio (use either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
